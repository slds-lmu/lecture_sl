\begin{enumerate}

    \item
        Since $\Xmat^T \Xmat = \id$, the unregularized minimizer simplifies to
        $$
            \thetavh = (\underbrace{\Xmat^T \Xmat}_{= \id})^{-1} \Xmat^T \yv = \Xmat^T \yv
        $$
        We write the sum of squares in matrix form and use $\yv^T \Xmat = \thetavh^T$:
        \begin{align*}
            \argmin_{\thetav} \riskrt &= \argmin_{\thetav} \frac{1}{2} \sumin (\yi - \thetav^T \xi)^2 + \lambda ||\thetav||_1 \\
            &= \argmin_{\thetav} \frac{1}{2} (\yv - \Xmat \thetav)^T (\yv - \Xmat \thetav) + \lambda ||\thetav||_1 \\
            &= \argmin_{\thetav} \frac{1}{2} (\underbrace{\yv^T \yv}_{\text{indep.\ of } \thetav} - 2 \underbrace{\yv^T \Xmat}_{= \thetavh^T} \thetav + \thetav^T \underbrace{\Xmat^T \Xmat}_{= \id} \thetav) + \lambda ||\thetav||_1 \\
            &= \argmin_{\thetav} -\thetavh^T \thetav + \frac{1}{2} \thetav^T \thetav + \lambda ||\thetav||_1 \\
            &= \argmin_{\thetav} \sumjp (-\thetah_j \theta_j + \frac{\theta_j^2}{2} + \lambda |\theta_j|)
        \end{align*}
        In the fourth line, we drop the constant $\frac{1}{2} \yv^T \yv$, which does not change the minimizer.

    \item
        Each $\theta_j$ appears in exactly one summand $g_j(\theta_j)$.
        Hence, we can minimize each $g_j$ separately, which is a one-dimensional problem,
        and stack the minimizers $\theta_1^*, \ldots, \theta_p^*$ to get the minimizer of $\riskrt$.

    \item
        Let $\thetah_j > 0$.
        The quadratic term and the penalty of $g_j$ are symmetric in $\theta_j$, so only the linear term differs between $\theta_j$ and $-\theta_j$.
        For $\theta_j > 0$:
        $$
            g_j(\theta_j) - g_j(-\theta_j) = -\thetah_j \theta_j - \thetah_j \theta_j = -2 \thetah_j \theta_j < 0
        $$
        So every negative value $-\theta_j$ has a strictly larger objective than its mirror image $\theta_j > 0$.
        Hence, no negative value can minimize $g_j$, and $\theta_j^* \geq 0$.

    \item
        Let $\thetah_j > 0$.
        By (c), we only need to minimize $g_j$ on $[0, \infty)$.
        For $\theta_j > 0$, we have $|\theta_j| = \theta_j$, so $g_j$ is differentiable with
        $$
            g_j'(\theta_j) = -\thetah_j + \theta_j + \lambda = \theta_j - (\thetah_j - \lambda)
        $$
        This derivative is increasing in $\theta_j$, and $g_j$ is continuous at 0. We distinguish two cases:
        \begin{itemize}
            \item $\thetah_j > \lambda$: $g_j'$ is negative on $(0, \thetah_j - \lambda)$ and positive on $(\thetah_j - \lambda, \infty)$.
                Hence, $\theta_j^* = \thetah_j - \lambda > 0$.
            \item $\thetah_j \leq \lambda$: $g_j'(\theta_j) > 0$ for all $\theta_j > 0$, so $g_j$ is strictly increasing on $[0, \infty)$.
                Hence, $\theta_j^* = 0$.
        \end{itemize}
        Both cases together give $\theta_j^* = \max\{\thetah_j - \lambda, 0\}$.

    \item
        Let $\thetah_j \leq 0$. As in (c), for $\theta_j > 0$:
        $$
            g_j(\theta_j) - g_j(-\theta_j) = -2 \thetah_j \theta_j \geq 0
        $$
        \begin{itemize}
            \item $\thetah_j < 0$: The inequality is strict, so every positive value $\theta_j$ has a strictly larger objective than its mirror image $-\theta_j < 0$.
                Hence, no positive value can minimize $g_j$, and $\theta_j^* \leq 0$.
            \item $\thetah_j = 0$: $g_j(\theta_j) = \frac{\theta_j^2}{2} + \lambda |\theta_j|$ is minimized only by $\theta_j^* = 0 \leq 0$.
        \end{itemize}

    \item
        Let $\thetah_j \leq 0$.
        By (e), we only need to minimize $g_j$ on $(-\infty, 0]$.
        For $\theta_j < 0$, we have $|\theta_j| = -\theta_j$, so $g_j$ is differentiable with
        $$
            g_j'(\theta_j) = -\thetah_j + \theta_j - \lambda = \theta_j - (\thetah_j + \lambda)
        $$
        Again, this derivative is increasing in $\theta_j$, and $g_j$ is continuous at 0. We distinguish two cases:
        \begin{itemize}
            \item $\thetah_j < -\lambda$: $g_j'$ is negative on $(-\infty, \thetah_j + \lambda)$ and positive on $(\thetah_j + \lambda, 0)$.
                Hence, $\theta_j^* = \thetah_j + \lambda < 0$.
            \item $\thetah_j \geq -\lambda$: $g_j'(\theta_j) < 0$ for all $\theta_j < 0$, so $g_j$ is strictly decreasing on $(-\infty, 0]$.
                Hence, $\theta_j^* = 0$.
        \end{itemize}
        Both cases together give $\theta_j^* = \min\{\thetah_j + \lambda, 0\}$.

    \item
        We check the three possible signs of $\thetah_j$, using $\sign(0) = 0$:
        \begin{itemize}
            \item $\thetah_j > 0$: $\sign(\thetah_j) = 1$ and $|\thetah_j| = \thetah_j$, so
                $\sign(\thetah_j) \max\{|\thetah_j| - \lambda, 0\} = \max\{\thetah_j - \lambda, 0\}$, which is $\theta_j^*$ from (d).
            \item $\thetah_j < 0$: $\sign(\thetah_j) = -1$ and $|\thetah_j| = -\thetah_j$.
                With $-\max\{a, b\} = \min\{-a, -b\}$, we get
                $\sign(\thetah_j) \max\{|\thetah_j| - \lambda, 0\} = -\max\{-\thetah_j - \lambda, 0\} = \min\{\thetah_j + \lambda, 0\}$, which is $\theta_j^*$ from (f).
            \item $\thetah_j = 0$: The formula gives 0, and (f) gives $\theta_j^* = \min\{\lambda, 0\} = 0$.
        \end{itemize}
        Hence, $\thetah_{\text{lasso},j} = \theta_j^* = \sign(\thetah_j) \max\{|\thetah_j| - \lambda, 0\}$ for all $j = 1, \ldots, p$.
        This is the soft-thresholding operator from the lecture:
        coefficients with $|\thetah_j| \leq \lambda$ are set to exactly 0, all others are shrunk toward 0 by $\lambda$.

\end{enumerate}

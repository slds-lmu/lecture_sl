\begin{enumerate}
    \item
        By linearity of the expectation:
        \begin{align*}
            \E(||\bm{X}||_1) &= \E(\sumjp |X_j|) \\
            &= \sumjp \underbrace{\E|X_j|}_{= \sqrt{2 / \pi}} \\
            &= p \sqrt{\frac{2}{\pi}}
        \end{align*}

    \item
        Since $X_1, \ldots, X_p$ are independent, so are $|X_1|, \ldots, |X_p|$.
        Hence, the variance of the sum equals the sum of the variances:
        \begin{align*}
            \var(||\bm{X}||_1) &= \var(\sumjp |X_j|) \\
            &= \sumjp \underbrace{\var|X_j|}_{= 1 - 2 / \pi} \\
            &= (1 - \frac{2}{\pi}) p
        \end{align*}

    \item
        Since $\bm{X}$ and $\bm{X}'$ are independent, $X_j$ and $X_j'$ are independent $\normal(0, 1)$ variables.
        The difference of two independent normal variables is again normal, with means subtracted and variances added:
        $$
            X_j - X_j' \sim \normal(0 - 0, 1 + 1) = \normal(0, 2)
        $$
        Scaling a random variable by a constant $c$ scales its variance by $c^2$, so
        $$
            Z_j := \frac{X_j - X_j'}{\sqrt{2}} \sim \normal(0, 1)
        $$
        With $|X_j - X_j'| = \sqrt{2} |Z_j|$ and the hint from (a) applied to $Z_j$:
        \begin{align*}
            \E(||\bm{X} - \bm{X}'||_1) &= \E(\sumjp |X_j - X_j'|) \\
            &= \sqrt{2} \sumjp \underbrace{\E|Z_j|}_{= \sqrt{2 / \pi}} \\
            &= p \sqrt{2} \sqrt{\frac{2}{\pi}} \\
            &= \frac{2p}{\sqrt{\pi}}
        \end{align*}

    \item
        The pairs $(X_j, X_j')$, $j = 1, \ldots, p$, are independent, so $Z_1, \ldots, Z_p$ are independent.
        With $Z_j$ from (c) and the hint from (b) applied to $Z_j$:
        \begin{align*}
            \var(||\bm{X} - \bm{X}'||_1) &= \sumjp \var|X_j - X_j'| \\
            &= \sumjp \var(\sqrt{2} |Z_j|) \\
            &= 2 \sumjp \underbrace{\var|Z_j|}_{= 1 - 2 / \pi} \\
            &= 2 (1 - \frac{2}{\pi}) p
        \end{align*}
        Note: Both mean and variance of the distance grow linearly in $p$,
        so the standard deviation only grows like $\sqrt{p}$.
        The relative spread $\sqrt{\var(||\bm{X} - \bm{X}'||_1)} / \E(||\bm{X} - \bm{X}'||_1) = \sqrt{(\pi - 2) / (2p)}$ goes to 0 for $p \to \infty$:
        distances between random points concentrate around their mean,
        which is one reason why nearest neighbors become less meaningful in high dimensions.

        The figure shows 200 simulated distances $||\bm{X} - \bm{X}'||_1$ per $p$ (points)
        and the mean $\pm$ 2 standard deviations from (c) and (d) (line and band).
        Left: centered at the mean, the spread grows like $\sqrt{p}$.
        Right: relative to the mean, it shrinks like $1 / \sqrt{p}$.

<<cod-l1-distances, echo=FALSE, message=FALSE, fig.height=3, fig.width=7, fig.align="center", out.width="0.9\\textwidth">>=
library(ggplot2)
library(data.table)

set.seed(1L)
p_grid = c(1L, 2L, 5L, 10L, 20L, 50L, 100L, 200L, 500L, 1000L)
n = 200L

# simulate n L1 distances between independent standard normal vectors per p
sim = rbindlist(lapply(p_grid, function(p) {
  x = matrix(rnorm(n * p), n, p)
  x_prime = matrix(rnorm(n * p), n, p)
  data.table(p = p, dist = rowSums(abs(x - x_prime)))
}))

# theoretical mean and sd from (c) and (d)
theory = data.table(p = p_grid)
theory[, `:=`(mean = 2 * p / sqrt(pi), sd = sqrt(2 * (1 - 2 / pi) * p))]
sim[theory, `:=`(centered = dist - i.mean, rel = dist / i.mean), on = "p"]

panels = c("Distance - mean", "Distance / mean")
points = rbind(
  sim[, .(p, value = centered, panel = panels[1L])],
  sim[, .(p, value = rel, panel = panels[2L])]
)
bands = rbind(
  theory[, .(p, center = 0, lower = -2 * sd, upper = 2 * sd, panel = panels[1L])],
  theory[, .(p, center = 1, lower = pmax(1 - 2 * sd / mean, 0), upper = 1 + 2 * sd / mean, panel = panels[2L])]
)

ggplot(points, aes(x = p)) +
  geom_ribbon(data = bands, aes(ymin = lower, ymax = upper), fill = "steelblue", alpha = 0.25) +
  geom_point(aes(y = value), position = position_jitter(width = 0.04, height = 0), alpha = 0.2, size = 0.6) +
  geom_line(data = bands, aes(y = center), color = "steelblue4", linewidth = 0.8) +
  facet_wrap(~panel, scales = "free_y") +
  scale_x_log10(breaks = c(1L, 10L, 100L, 1000L)) +
  labs(x = "p", y = NULL) +
  theme_bw(base_size = 11) +
  theme(panel.grid.minor = element_blank())
@

    \item
        By linearity of the expectation and since $\xv$ is deterministic:
        \begin{align*}
            \E(\scp{\bm{X}}{\xv}) &= \E(\sumjp X_j x_j) \\
            &= \sumjp x_j \underbrace{\E(X_j)}_{= 0} \\
            &= 0
        \end{align*}
        By independence of $X_1, \ldots, X_p$ and since $\xv$ is deterministic:
        \begin{align*}
            \var(\scp{\bm{X}}{\xv}) &= \var(\sumjp X_j x_j) \\
            &= \sumjp x_j^2 \underbrace{\var(X_j)}_{= 1} \\
            &= ||\xv||_2^2
        \end{align*}

    \item
        As a linear combination of independent normal variables, $\scp{\bm{X}}{\xv}$ is normal, so by (e) $\scp{\bm{X}}{\xv} / ||\xv||_2 \sim \normal(0, 1)$ for every $p$.
        In contrast, $||\bm{X}||_2 \approx \sqrt{p}$ grows with $p$
        (since $\E(||\bm{X}||_2^2) = \sum_{j=1}^p \E(X_j^2) = p$, and the relative spread of $||\bm{X}||_2^2$ is $\sqrt{2 / p} \to 0$).
        Hence:
        $$
            \cos \angle(\bm{X}, \xv) = \frac{\scp{\bm{X}}{\xv}}{||\bm{X}||_2 ||\xv||_2} \approx \frac{Z}{\sqrt{p}} \quad Z \sim \normal(0, 1)
        $$
        This goes to 0 for $p \to \infty$:
        a random direction is almost orthogonal to any fixed vector in high dimensions.
        E.g., for $p = 100$, the angle lies roughly between $78^\circ$ and $102^\circ$ ($\pm 2$ standard deviations of the cosine).
\end{enumerate}
